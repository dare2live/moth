{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/moth.guidance-application.schema.json",
  "title": "Moth Guidance Application Report",
  "type": "object",
  "required": [
    "schema_version",
    "report_id",
    "contract_id",
    "run_id",
    "source_id",
    "source_digest",
    "loaded_at",
    "decision_summary",
    "evidence_refs",
    "decisions_influenced",
    "conflicts"
  ],
  "properties": {
    "schema_version": {
      "const": "moth.guidance_application.v1"
    },
    "report_id": {
      "$ref": "#/$defs/id"
    },
    "contract_id": {
      "$ref": "#/$defs/id"
    },
    "run_id": {
      "$ref": "#/$defs/id"
    },
    "source_id": {
      "$ref": "#/$defs/id"
    },
    "source_digest": {
      "type": "string",
      "pattern": "^sha256:[a-fA-F0-9]{64}$"
    },
    "loaded_at": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[^\\s]+Z$"
    },
    "decision_summary": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1024
    },
    "evidence_refs": {
      "$ref": "#/$defs/non_empty_ref_list"
    },
    "decisions_influenced": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "items": {
        "type": "object",
        "required": ["decision_id", "summary", "evidence_refs"],
        "properties": {
          "decision_id": {
            "$ref": "#/$defs/id"
          },
          "summary": {
            "type": "string",
            "minLength": 1,
            "maxLength": 1024
          },
          "evidence_refs": {
            "$ref": "#/$defs/non_empty_ref_list"
          }
        },
        "additionalProperties": false
      }
    },
    "conflicts": {
      "type": "array",
      "maxItems": 16,
      "items": {
        "type": "object",
        "required": [
          "conflict_id",
          "with_source_ids",
          "resolution",
          "evidence_refs"
        ],
        "properties": {
          "conflict_id": {
            "$ref": "#/$defs/id"
          },
          "with_source_ids": {
            "type": "array",
            "minItems": 1,
            "maxItems": 32,
            "uniqueItems": true,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "resolution": {
            "enum": [
              "ACCEPT_GUIDANCE",
              "REJECT_GUIDANCE",
              "MERGED",
              "DEFERRED"
            ]
          },
          "evidence_refs": {
            "$ref": "#/$defs/non_empty_ref_list"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "$defs": {
    "id": {
      "type": "string",
      "maxLength": 128,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "ref": {
      "type": "string",
      "maxLength": 256,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_.:-]*$"
    },
    "non_empty_ref_list": {
      "type": "array",
      "minItems": 1,
      "maxItems": 32,
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/ref"
      }
    }
  },
  "additionalProperties": false
}
