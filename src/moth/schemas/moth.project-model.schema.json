{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/moth.project-model.schema.json",
  "title": "Moth Project Model",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "project",
    "applications",
    "runtimes",
    "modules",
    "entities",
    "relations",
    "flows",
    "state_machines",
    "architecture",
    "evidence",
    "coverage"
  ],
  "properties": {
    "schema_version": {"const": "moth.project-model.v2"},
    "verdict": {"enum": ["PASS", "WARN", "FAIL"]},
    "project": {
      "type": ["object", "null"],
      "required": ["id", "name", "version", "description", "evidence_ids"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": ["string", "null"]},
        "description": {"type": ["string", "null"]},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "subtype",
          "entrypoint",
          "runtime_id",
          "evidence_ids"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"const": "application"},
          "subtype": {"type": "string"},
          "entrypoint": {"type": "string"},
          "runtime_id": {"type": "string"},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "constraint", "dependencies", "evidence_ids"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"const": "runtime"},
          "constraint": {"type": ["string", "null"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "name", "subtype", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "minLength": 1},
          "kind": {"type": "string", "minLength": 1},
          "name": {"type": "string", "minLength": 1},
          "subtype": {"type": "string", "minLength": 1},
          "locator": {"$ref": "#/$defs/relativePath"},
          "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
        },
        "additionalProperties": true
      }
    },
    "entities": {
      "type": "array",
      "items": {"$ref": "#/$defs/entity"}
    },
    "relations": {
      "type": "array",
      "items": {"$ref": "#/$defs/relation"}
    },
    "flows": {
      "type": "array",
      "items": {"$ref": "#/$defs/flow"}
    },
    "state_machines": {
      "type": "array",
      "items": {"$ref": "#/$defs/stateMachine"}
    },
    "architecture": {"$ref": "#/$defs/architecture"},
    "evidence": {
      "type": "array",
      "items": {"$ref": "#/$defs/evidence"}
    },
    "coverage": {
      "type": "object",
      "required": ["detectors", "issues", "warnings"],
      "properties": {
        "detectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "state"],
            "properties": {
              "id": {"type": "string"},
              "state": {
                "enum": ["NOT_DETECTED", "INVALID", "DETECTED"]
              }
            },
            "additionalProperties": false
          }
        },
        "issues": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "relativePath": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "evidenceIds": {
      "type": "array",
      "items": {"type": "string"},
      "uniqueItems": true
    },
    "evidence": {
      "type": "object",
      "required": ["id", "kind", "locator", "sha256"],
      "properties": {
        "id": {"type": "string"},
        "kind": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/relativePath"},
        "sha256": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        }
      },
      "additionalProperties": false
    },
    "entity": {
      "type": "object",
      "required": ["id", "kind", "name", "responsibility", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "responsibility": {"type": "string", "minLength": 1},
        "locator": {"$ref": "#/$defs/relativePath"},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
      },
      "additionalProperties": false
    },
    "entityConstraint": {
      "allOf": [
        {"$ref": "#/$defs/entity"},
        {
          "type": "object",
          "required": ["expectation"],
          "properties": {
            "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
          }
        }
      ]
    },
    "relation": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "source_id",
        "target_id",
        "label",
        "evidence_ids"
      ],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"type": "string", "minLength": 1},
        "source_id": {"type": "string", "minLength": 1},
        "target_id": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
      },
      "additionalProperties": false
    },
    "relationConstraint": {
      "allOf": [
        {"$ref": "#/$defs/relation"},
        {
          "type": "object",
          "required": ["expectation"],
          "properties": {
            "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
          }
        }
      ]
    },
    "step": {
      "type": "object",
      "required": ["id", "entity_id", "action"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "entity_id": {"type": "string", "minLength": 1},
        "action": {"type": "string", "minLength": 1},
        "from_state": {"type": "string", "minLength": 1},
        "to_state": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "flow": {
      "type": "object",
      "required": ["id", "name", "steps", "evidence_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "steps": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/step"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
      },
      "additionalProperties": false
    },
    "flowConstraint": {
      "allOf": [
        {"$ref": "#/$defs/flow"},
        {
          "type": "object",
          "required": ["expectation"],
          "properties": {
            "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
          }
        }
      ]
    },
    "transition": {
      "type": "object",
      "required": ["id", "from_state", "to_state", "trigger"],
      "properties": {
        "id": {"type": "string"},
        "from_state": {"type": "string"},
        "to_state": {"type": "string"},
        "trigger": {"type": "string"}
      },
      "additionalProperties": false
    },
    "stateMachine": {
      "type": "object",
      "required": [
        "id",
        "entity_id",
        "initial_state",
        "states",
        "transitions",
        "evidence_ids"
      ],
      "properties": {
        "id": {"type": "string"},
        "entity_id": {"type": "string"},
        "initial_state": {"type": "string"},
        "states": {
          "type": "array",
          "items": {"type": "string"},
          "uniqueItems": true
        },
        "transitions": {
          "type": "array",
          "items": {"$ref": "#/$defs/transition"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
      },
      "additionalProperties": false
    },
    "stateMachineConstraint": {
      "allOf": [
        {"$ref": "#/$defs/stateMachine"},
        {
          "type": "object",
          "required": ["expectation"],
          "properties": {
            "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]}
          }
        }
      ]
    },
    "architectureState": {
      "type": "object",
      "required": [
        "state",
        "complete",
        "entity_ids",
        "relation_ids",
        "flow_ids",
        "state_machine_ids",
        "evidence_ids"
      ],
      "properties": {
        "state": {"enum": ["OBSERVED", "NOT_OBSERVED"]},
        "complete": {"type": "boolean"},
        "entity_ids": {"type": "array", "items": {"type": "string"}},
        "relation_ids": {"type": "array", "items": {"type": "string"}},
        "flow_ids": {"type": "array", "items": {"type": "string"}},
        "state_machine_ids": {"type": "array", "items": {"type": "string"}},
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      },
      "additionalProperties": false
    },
    "desiredState": {
      "type": "object",
      "required": [
        "state",
        "complete",
        "entities",
        "relations",
        "flows",
        "state_machines",
        "evidence_ids"
      ],
      "properties": {
        "state": {"enum": ["DECLARED", "NOT_DECLARED", "INVALID"]},
        "complete": {"type": "boolean"},
        "entities": {
          "type": "array",
          "items": {"$ref": "#/$defs/entityConstraint"}
        },
        "relations": {
          "type": "array",
          "items": {"$ref": "#/$defs/relationConstraint"}
        },
        "flows": {
          "type": "array",
          "items": {"$ref": "#/$defs/flowConstraint"}
        },
        "state_machines": {
          "type": "array",
          "items": {"$ref": "#/$defs/stateMachineConstraint"}
        },
        "evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      },
      "additionalProperties": false
    },
    "driftFinding": {
      "type": "object",
      "required": [
        "id",
        "subject_id",
        "subject_kind",
        "expectation",
        "status",
        "reason",
        "declaration_evidence_ids",
        "observation_evidence_ids"
      ],
      "properties": {
        "id": {"type": "string"},
        "subject_id": {"type": "string"},
        "subject_kind": {"type": "string"},
        "expectation": {"enum": ["REQUIRED", "FORBIDDEN"]},
        "status": {"enum": ["VIOLATION", "UNVERIFIABLE", "CONFORMANT"]},
        "reason": {"type": "string"},
        "declaration_evidence_ids": {"$ref": "#/$defs/evidenceIds"},
        "observation_evidence_ids": {"$ref": "#/$defs/evidenceIds"}
      },
      "additionalProperties": false
    },
    "drift": {
      "type": "object",
      "required": [
        "state",
        "findings",
        "violation_ids",
        "unverifiable_ids",
        "conformant_ids"
      ],
      "properties": {
        "state": {
          "enum": [
            "NOT_COMPUTED",
            "CONFORMANT",
            "DRIFT_DETECTED",
            "UNVERIFIABLE"
          ]
        },
        "findings": {
          "type": "array",
          "items": {"$ref": "#/$defs/driftFinding"}
        },
        "violation_ids": {"type": "array", "items": {"type": "string"}},
        "unverifiable_ids": {"type": "array", "items": {"type": "string"}},
        "conformant_ids": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "architecture": {
      "type": "object",
      "required": [
        "schema_version",
        "declaration_state",
        "current",
        "desired",
        "drift",
        "issues",
        "warnings"
      ],
      "properties": {
        "schema_version": {"const": "moth.architecture-model.v1"},
        "declaration_state": {
          "enum": ["NOT_DECLARED", "DECLARED", "INVALID"]
        },
        "current": {"$ref": "#/$defs/architectureState"},
        "desired": {"$ref": "#/$defs/desiredState"},
        "drift": {"$ref": "#/$defs/drift"},
        "issues": {"type": "array", "items": {"type": "string"}},
        "warnings": {"type": "array", "items": {"type": "string"}}
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false
}
