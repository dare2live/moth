{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.local/moth.project-model.schema.json",
  "title": "Moth Project Model",
  "type": "object",
  "required": [
    "schema_version",
    "verdict",
    "project",
    "applications",
    "runtimes",
    "modules",
    "evidence",
    "coverage"
  ],
  "properties": {
    "schema_version": {
      "const": "moth.project-model.v1"
    },
    "verdict": {
      "type": "string",
      "enum": ["PASS", "WARN", "FAIL"]
    },
    "project": {
      "type": ["object", "null"],
      "required": ["id", "name", "version", "description", "evidence_ids"],
      "properties": {
        "id": {"type": "string"},
        "name": {"type": "string", "minLength": 1},
        "version": {"type": "string"},
        "description": {"type": "string"},
        "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
      },
      "additionalProperties": false
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "kind",
          "subtype",
          "entrypoint",
          "runtime_id",
          "evidence_ids"
        ],
        "properties": {
          "id": {"type": "string"},
          "name": {"type": "string"},
          "kind": {"const": "application"},
          "subtype": {"type": "string"},
          "entrypoint": {"type": "string"},
          "runtime_id": {"type": "string"},
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        },
        "additionalProperties": false
      }
    },
    "runtimes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "constraint", "dependencies", "evidence_ids"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"const": "runtime"},
          "constraint": {"type": ["string", "null"]},
          "dependencies": {
            "type": "array",
            "items": {"type": "string"}
          },
          "evidence_ids": {"$ref": "#/$defs/evidence_ids"}
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "array",
      "items": {"type": "object"}
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "kind", "locator", "sha256"],
        "properties": {
          "id": {"type": "string"},
          "kind": {"const": "manifest"},
          "locator": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
          },
          "sha256": {
            "type": "string",
            "pattern": "^sha256:[0-9a-f]{64}$"
          }
        },
        "additionalProperties": false
      }
    },
    "coverage": {
      "type": "object",
      "required": ["detectors", "issues", "warnings"],
      "properties": {
        "detectors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["id", "state"],
            "properties": {
              "id": {"type": "string"},
              "state": {
                "type": "string",
                "enum": ["NOT_DETECTED", "INVALID", "DETECTED"]
              }
            },
            "additionalProperties": false
          }
        },
        "issues": {
          "type": "array",
          "items": {"type": "string"}
        },
        "warnings": {
          "type": "array",
          "items": {"type": "string"}
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "evidence_ids": {
      "type": "array",
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
